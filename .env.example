# Copy to .env (same folder as main.py). Never commit .env or put a key in the HTML.

# ---- Option A: free local model with Ollama (no API key, no token cost, works offline)
AURASYNC_LLM_PROVIDER=ollama
# qwen3:4b fits an 8 GB Mac; use qwen3:8b with 16 GB+ RAM
AURASYNC_LLM_MODEL=qwen3:4b-instruct
# Context window the launcher gives Ollama (8192 for an 8 GB Mac, 16384 with 16 GB+)
AURASYNC_OLLAMA_CONTEXT=8192

# ---- Option B: OpenAI API (paid per token) — comment out Option A and use:
# AURASYNC_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AURASYNC_OPENAI_MODEL=gpt-4o-mini

# Folder holding articles.csv, catalog_emb_*.npy/.csv, color_features.csv, style_personas.csv and the
# aurasync_*_outputs sub-folders. Defaults to ~/Downloads.
AURASYNC_DATA_DIR=/Users/mac/Downloads

# Speed (local model): the router answers common questions with one model call; the model stays loaded 60 min
# AURASYNC_CHAT_ROUTER=1
# AURASYNC_OLLAMA_KEEP_ALIVE=60m
# AURASYNC_LLM_MAX_OUTPUT_TOKENS=500

# Optional
# AURASYNC_ARL_RULES_PATH=/Users/mac/Downloads/arl_rules.csv
# AURASYNC_CUSTOMER_FEATURES_PATH=/Users/mac/Downloads/customer_features.csv
# AURASYNC_CHURN_FEATURES_PATH=/Users/mac/Downloads/aurasync_economist_outputs/churn_customer_features.csv
# AURASYNC_CHAT_TEMPERATURE=0.3        # leave unset for reasoning models
# AURASYNC_CHAT_MAX_TOOL_ROUNDS=6
# AURASYNC_CHAT_HISTORY_MESSAGES=30    # local mode: past messages resent each call
# AURASYNC_LLM_REASONING_EFFORT=none   # local default: thinking off (think=false); 'default' = model's own setting
# Other OpenAI-compatible servers (LM Studio, Groq, ...):
# AURASYNC_LLM_PROVIDER=custom
# AURASYNC_LLM_BASE_URL=http://localhost:1234/v1
# AURASYNC_LLM_API_KEY=...
